# Source'd by `task dev:backend`. Safe to commit — no real secrets.
PORTAL_ENV=dev
# The browser-visible URL. Vite at :5173 proxies /api, /auth, /login, /.well-known
# through to uvicorn at :8088. In prod this is https://portal.apps.example.com.
PORTAL_PORTAL_BASE_URL=http://localhost:5173
# Uncomment for the identity-free /dev/login endpoint (never outside local dev).
# PORTAL_ENABLE_DEV_LOGIN=true
PORTAL_DATABASE_URL=postgresql+asyncpg://portal:portal@localhost:5433/portal
PORTAL_SESSION_SECRET=dev-secret-change-me-to-something-32chars-aaa
PORTAL_OKTA_ISSUER=http://mock-idp.iapportal.test:8081
PORTAL_OKTA_CLIENT_ID=portal-local
PORTAL_OKTA_CLIENT_SECRET=secret
PORTAL_JWT_KID=dev-v1
PORTAL_JWT_PRIVATE_KEY_PEM=""
PORTAL_JWT_PUBLIC_KEY_PEM=""
